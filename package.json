{
  "name": "kino-kak-sposob-myshleniya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сайт курса «Кино как способ мышления» — личный тренажёр внимательного просмотра без бэкенда.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "shots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
